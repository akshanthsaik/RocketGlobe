VITE_API_BASE_URL=http://127.0.0.1:8000/api
# The globe renders without imagery tiles - flat ground plus country outlines -
# so no Cesium Ion token is needed and the globe works offline.
# Enables backend/.env's ADMIN_TOKEN check. Vite auto-loads this from .env for the
# frontend bundle, but src-tauri (Rust) does not parse .env files - to also apply
# this token to the spawned dev backend, export VITE_ADMIN_TOKEN in your shell
# before running `bun run tauri dev`, not just in this file.
VITE_ADMIN_TOKEN=
