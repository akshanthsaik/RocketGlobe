{
  "name": "rocketglobe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1 -DatabaseUrl \"$env:DATABASE_URL\"",
    "release:windows:local": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,json}": "prettier --write",
    "backend/**/*.py": "node scripts/ruff-staged.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2",
    "cesium": "^1.136.0",
    "framer-motion": "^12.23.25",
    "prettier": "^3.7.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^4.1.10"
  }
}
