DATABASE_URL=sqlite:///./rocketglobe.db
LL2_BASE_URL=https://ll.thespacedevs.com/2.3.0
LL2_SYNC_INTERVAL=900
LL2_MIN_REQUEST_INTERVAL=2.0
LL2_BASE_BACKOFF=1.0
LL2_MAX_BACKOFF=60.0
LL2_MAX_RETRIES=8
LL2_MAX_WAIT_SECONDS=120
LL2_MAX_REQUEST_DURATION=300
LL2_SYNC_PAGE_LIMIT=500
LL2_LAUNCHES_MIN_REQUEST_INTERVAL=2.5
LL2_LAUNCHES_MAX_RETRIES=20
LL2_LAUNCHES_MAX_WAIT_SECONDS=300
LL2_LAUNCHES_MAX_REQUEST_DURATION=1800
LL2_STATIC_RESOURCES_MIN_INTERVAL=86400
LL2_EXISTING_DATA_LOOKBACK_HOURS=24
LL2_ALLOW_PARTIAL_SYNC_ON_RATE_LIMIT=true
SQL_ECHO=False
API_HOST=127.0.0.1
API_PORT=8000
# Must match the frontend's VITE_ADMIN_TOKEN (see root .env.example) - when run via
# `bun run tauri dev`, src-tauri forwards VITE_ADMIN_TOKEN from your shell env as this
# value, so set that instead of this file when running through Tauri.
ADMIN_TOKEN=
# Dev: set true to see sync subprocess logs in the uvicorn terminal (default: file only).
SYNC_SUBPROCESS_INHERIT_STDERR=false
