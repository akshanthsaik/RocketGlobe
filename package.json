{
  "name": "rocketglobe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1 -DatabaseUrl \"$env:DATABASE_URL\" -CesiumToken \"$env:VITE_CESIUM_ION_ACCESS_TOKEN\"",
    "release:windows:local": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "cesium": "^1.136.0",
    "framer-motion": "^12.23.25",
    "prettier": "^3.7.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resium": "^1.19.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-cesium": "^1.2.23"
  }
}
